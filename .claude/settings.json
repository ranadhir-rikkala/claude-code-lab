{
  "permissions": {
    "allow": [
      "Bash(mvn -q test:*)",
      "Bash(./scripts/run.sh:*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "mcp__alert-files__write_file",
      "mcp__alert-files__append_file",
      "mcp__alert-files__edit_file",
      "mcp__alert-files__create_directory",
      "mcp__alert-files__move_file",
      "mcp__alert-files__copy_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-sample-data.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-after-java-edit.sh" }
        ]
      }
    ]
  }
}
